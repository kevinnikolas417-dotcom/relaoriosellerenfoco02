    let currentRole = "master";
    let currentPeriod = 7;

    function brl(value) {
      if (value === null || value === undefined || Number.isNaN(value)) {
        return "Não disponível";
      }

      return value.toLocaleString("pt-BR", {
        style: "currency",
        currency: "BRL"
      });
    }

    function num(value) {
      if (value === null || value === undefined || Number.isNaN(value)) {
        return "Não disponível";
      }

      return value.toLocaleString("pt-BR");
    }

    function pct(value) {
      if (value === null || value === undefined || Number.isNaN(value)) {
        return "Não disponível";
      }

      return value.toFixed(2).replace(".", ",") + "%";
    }

    function periodMultiplier() {
      if (currentPeriod === 15) return 2.15;
      if (currentPeriod === 30) return 4.3;
      return 1;
    }

    function calcMetric(campaign, metric) {
      const key = metric + "7";

      if (campaign[key] === null || campaign[key] === undefined) {
        return null;
      }

      return Math.round(campaign[key] * periodMultiplier() * 100) / 100;
    }

    function getVisibleCompanies() {
      return baseCompanies.filter(company => company.visibleTo.includes(currentRole));
    }

    function campaignValues(campaign) {
      const spend = calcMetric(campaign, "spend");
      const impressions = calcMetric(campaign, "impressions");
      const clicks = calcMetric(campaign, "clicks");
      const ctr = impressions ? (clicks / impressions) * 100 : null;
      const cpc = clicks ? spend / clicks : null;

      return {
        spend,
        impressions,
        clicks,
        ctr,
        cpc
      };
    }

    function renderFeed() {
      const feed = document.getElementById("feed");
      const companies = getVisibleCompanies();

      feed.innerHTML = "";

      let totalCampaigns = 0;
      let totalSpend = 0;
      let totalClicks = 0;

      companies.forEach((company, index) => {
        const validCampaigns = company.campaigns
          .map(campaign => ({
            ...campaign,
            values: campaignValues(campaign)
          }))
          .filter(campaign => campaign.values.spend !== null);

        const spend = validCampaigns.reduce((sum, campaign) => sum + campaign.values.spend, 0);
        const impressions = validCampaigns.reduce((sum, campaign) => sum + campaign.values.impressions, 0);
        const clicks = validCampaigns.reduce((sum, campaign) => sum + campaign.values.clicks, 0);

        const ctr = impressions ? (clicks / impressions) * 100 : null;
        const cpc = clicks ? spend / clicks : null;

        totalCampaigns += company.campaigns.length;
        totalSpend += spend;
        totalClicks += clicks;

        const block = document.createElement("article");
        block.className = "company-block";

        block.innerHTML = `
          <div class="company-head">
            <div class="company-title">
              <div class="company-number">${index + 1}</div>

              <div>
                <h2>Bloco ${index + 1}: ${company.name}</h2>
                <p>Conta de anúncios: ${company.account}</p>
              </div>
            </div>

            <div class="filter-group">
              <span class="pill green">Ativa</span>
              <span class="pill blue">${currentPeriod} dias</span>
            </div>
          </div>

          <div class="company-summary">
            <div class="mini">
              <span>Campanhas ativas</span>
              <strong>${company.campaigns.length}</strong>
            </div>

            <div class="mini">
              <span>Orçamento diário</span>
              <strong>${brl(company.dailyBudget)}</strong>
            </div>

            <div class="mini">
              <span>Gasto</span>
              <strong>${brl(spend)}</strong>
            </div>

            <div class="mini">
              <span>Impressões</span>
              <strong>${num(impressions)}</strong>
            </div>

            <div class="mini">
              <span>Cliques</span>
              <strong>${num(clicks)}</strong>
            </div>

            <div class="mini">
              <span>CTR / CPC</span>
              <strong>${pct(ctr)} · ${brl(cpc)}</strong>
            </div>
          </div>

          <div class="campaigns">
            ${company.campaigns.map(campaign => {
              const values = campaignValues(campaign);

              return `
                <div class="campaign-card">
                  <div>
                    <div class="name">${campaign.name}</div>
                    <div class="objective">${campaign.objective}</div>
                  </div>

                  <div class="metric">
                    <small>Gasto</small>
                    <strong>${brl(values.spend)}</strong>
                  </div>

                  <div class="metric">
                    <small>Impressões</small>
                    <strong>${num(values.impressions)}</strong>
                  </div>

                  <div class="metric">
                    <small>Cliques</small>
                    <strong>${num(values.clicks)}</strong>
                  </div>

                  <div class="metric">
                    <small>CTR</small>
                    <strong>${pct(values.ctr)}</strong>
                  </div>

                  <div class="metric">
                    <small>CPC</small>
                    <strong>${brl(values.cpc)}</strong>
                  </div>
                </div>
              `;
            }).join("")}
          </div>
        `;

        feed.appendChild(block);
      });

      document.getElementById("totalCompanies").textContent = companies.length;
      document.getElementById("totalCampaigns").textContent = totalCampaigns;
      document.getElementById("totalSpend").textContent = brl(totalSpend);
      document.getElementById("totalClicks").textContent = num(totalClicks);

      document.getElementById("sideCompanies").textContent =
        currentRole === "master"
          ? "Todas"
          : companies.map(company => company.name).join(", ");
    }

    function applyRoleVisibility() {
      document.querySelectorAll("[data-min-role]").forEach(element => {
        const minRole = element.getAttribute("data-min-role");

        if (roleRank[currentRole] < roleRank[minRole]) {
          element.classList.add("hidden");
        } else {
          element.classList.remove("hidden");
        }
      });
    }

    function login() {
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value;

      currentRole = document.getElementById("role").value;

      if (!email || !password) {
        alert("Preencha e-mail e senha.");
        return;
      }

      document.getElementById("loginScreen").style.display = "none";
      document.getElementById("app").style.display = "block";

      document.getElementById("sideUser").textContent = email;
      document.getElementById("sideRole").textContent = roleName[currentRole];

      applyRoleVisibility();
      renderFeed();
    }

    function logout() {
      document.getElementById("app").style.display = "none";
      document.getElementById("loginScreen").style.display = "grid";
    }

    function setPeriod(days) {
      currentPeriod = days;

      document.querySelectorAll(".period-btn").forEach(button => {
        button.classList.toggle("active", Number(button.dataset.period) === days);
      });

      renderFeed();
    }
